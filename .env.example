# Copy to .env for local development. On Netlify, set these under
# Project configuration > Environment variables.
#
# NEVER prefix secrets with VITE_: Vite puts every VITE_* variable into the public JavaScript bundle.

# --- Hedera (server only) ---
# testnet (default) | previewnet | mainnet
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=
# ecdsa (default) | ed25519 | der
HEDERA_KEY_TYPE=ecdsa
# Mainnet signs real transactions and costs real HBAR. It is refused unless this is "true".
HEDERA_ALLOW_MAINNET=false
# Lets the UI send HBAR from the operator account (max 100 per transfer).
HEDERA_ENABLE_TRANSFER=false

# --- Claude chatbot (server only) ---
# Set a monthly spend limit for this key in the Anthropic Console.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
CLAUDE_MODEL=

# --- Extra MCP tool servers for the chatbot (optional) ---
# JSON array, e.g. [{"id":"trace","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ..."}}]
MCP_SERVERS=
